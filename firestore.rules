rules_version = '2';
// Pravidla Firestore pro projekt skicacad.
// Každý přihlášený uživatel smí číst a zapisovat jen svá data pod users/{uid}
// (skicacad_designs, skicacad_blobs, skicacad_meta).
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
